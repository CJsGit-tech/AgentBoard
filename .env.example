# Optional provider credentials for the Playground. Leave blank when unused.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider model overrides.
# OPENAI_DEFAULT_MODEL=
# CLAUDE_DEFAULT_MODEL=
# AGENTBOARD_CODEX_MODEL=
# AGENTBOARD_CLAUDE_MODEL=

# Provider SDK adapters are enabled by Compose by default.
# Set either flag to false to disable that provider's workspace adapter.
# AGENTBOARD_CODEX_SDK_ENABLED=true
# AGENTBOARD_CLAUDE_AGENT_SDK_ENABLED=true
