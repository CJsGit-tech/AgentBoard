{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_project",
  "x-status": "draft",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "success"
            },
            "applied": {
              "const": false
            },
            "data": {
              "$ref": "../schemas/domain.schema.json#/$defs/Project"
            }
          },
          "required": [
            "outcome",
            "applied",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "error",
                "rejected",
                "cancelled",
                "expired"
              ]
            },
            "applied": {
              "const": false
            },
            "error": {
              "$ref": "../schemas/domain.schema.json#/$defs/ErrorDetail"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "outcome",
            "applied",
            "error",
            "request_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
