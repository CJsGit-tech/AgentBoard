{
  "name": "agentboard-ui",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:canvas": "tsc -p design-drafts/v2 && tsc -p design-drafts/v3",
    "build": "npm run typecheck && vite build",
    "test:forms": "node --test tests/form-actions.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@oddbird/popover-polyfill": "^0.7.3",
    "interestfor": "^1.0.14",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1"
  }
}
