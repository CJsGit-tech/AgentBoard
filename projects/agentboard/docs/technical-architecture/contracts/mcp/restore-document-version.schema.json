{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "restore_document_version",
  "x-status": "draft",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "operation_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "project_id",
        "document_id",
        "version_id",
        "expected_revision",
        "operation_key"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "success"
            },
            "applied": {
              "const": true
            },
            "data": {
              "$ref": "../schemas/domain.schema.json#/$defs/Document"
            }
          },
          "required": [
            "outcome",
            "applied",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "error",
                "rejected",
                "cancelled",
                "expired"
              ]
            },
            "applied": {
              "const": false
            },
            "error": {
              "$ref": "../schemas/domain.schema.json#/$defs/ErrorDetail"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "outcome",
            "applied",
            "error",
            "request_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "approval_required"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "ticket_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "applied": {
              "const": false
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "request_id",
            "ticket_id",
            "applied",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
