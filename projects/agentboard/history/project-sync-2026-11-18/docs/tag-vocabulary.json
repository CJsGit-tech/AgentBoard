  "concerns": [
    {
      "id": "concern:authorization",
      "definition": "Protects which actors may create, read, update, delete, or approve records."
    },
    {
      "id": "concern:auditability",
      "definition": "Makes agent and application actions attributable and reviewable."
    },
    {
      "id": "concern:data-integrity",
      "definition": "Preserves correct, current, and consistently linked records and revisions."
    },
    {
      "id": "concern:retention",
      "definition": "Defines time or count limits for logs, documents, and revisions."
    },
    {
      "id": "concern:privacy",
      "definition": "Limits exposure and collection of local project data and sensitive content."
    },
    {
      "id": "concern:reliability",
      "definition": "Covers failure handling, restart, reconnect, and recovery behavior."
    },
    {
      "id": "concern:compatibility",
      "definition": "Covers interoperability across Codex and Claude MCP clients."
    },
    {
      "id": "concern:accessibility",
      "definition": "Covers keyboard access, focus, contrast, and assistive technology."
    },
    {
      "id": "concern:security",
      "definition": "Protects credentials, origins, containers, inputs, and access boundaries."
    }
