{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentBoard domain and wire contracts",
  "x-status": "draft",
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "created_at",
        "updated_at",
        "name",
        "purpose"
      ],
      "additionalProperties": false
    },
    "Role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "responsibilities": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "created_at",
        "updated_at",
        "project_id",
        "name",
        "responsibilities"
      ],
      "additionalProperties": false
    },
    "TicketFields": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "done"
          ]
        },
        "owner_kind": {
          "type": "string",
          "enum": [
            "unassigned",
            "builder",
            "role"
          ]
        },
        "role_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocker_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "created_at",
        "updated_at",
        "project_id",
        "title",
        "description",
        "priority",
        "status",
        "owner_kind",
        "role_id",
        "blocker_reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "blocker_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "blocker_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "role"
              }
            }
          },
          "then": {
            "properties": {
              "role_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "else": {
            "properties": {
              "role_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "TicketRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/TicketFields"
        }
      ],
      "unevaluatedProperties": false,
      "description": "Persisted record. needs_approval is not a database status/column."
    },
    "TicketView": {
      "allOf": [
        {
          "$ref": "#/$defs/TicketFields"
        },
        {
          "type": "object",
          "properties": {
            "needs_approval": {
              "type": "boolean"
            }
          },
          "required": [
            "needs_approval"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "description": "Read projection; needs_approval is derived from pending mutation requests."
    },
    "Document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "current_version_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "revision",
        "created_at",
        "updated_at",
        "project_id",
        "title",
        "content",
        "version",
        "current_version_id"
      ],
      "additionalProperties": false
    },
    "DocumentVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "author_client_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "builder",
            "agent"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "project_id",
        "document_id",
        "version",
        "content",
        "author_client_id",
        "source",
        "created_at"
      ],
      "additionalProperties": false
    },
    "TicketDocument": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "ticket_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "context",
            "output"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "project_id",
        "ticket_id",
        "document_id",
        "relationship",
        "created_at"
      ],
      "additionalProperties": false
    },
    "MutationRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "ticket_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "project",
            "role",
            "ticket",
            "document",
            "ticket_document"
          ]
        },
        "target_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "type": "string",
          "enum": [
            "update",
            "delete",
            "restore",
            "unlink"
          ]
        },
        "proposed_changes": {
          "type": "object"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requester_client_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "applied",
            "rejected",
            "cancelled",
            "expired",
            "stale"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "ticket_id",
        "target_kind",
        "target_id",
        "operation",
        "proposed_changes",
        "base_revision",
        "payload_hash",
        "requester_client_id",
        "status",
        "created_at",
        "expires_at",
        "decided_at"
      ],
      "additionalProperties": false
    },
    "ActivityEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "ticket_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_client_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "dispatch",
            "tool_call",
            "ticket_update",
            "work",
            "api_operation",
            "maintenance"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "started",
            "success",
            "failed",
            "pending",
            "rejected",
            "cancelled"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 2048
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "api_observed",
            "mcp_observed",
            "agent_reported",
            "maintenance"
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "ticket_id",
        "agent_client_id",
        "agent_name",
        "action",
        "event_type",
        "outcome",
        "summary",
        "labels",
        "occurred_at",
        "received_at",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
